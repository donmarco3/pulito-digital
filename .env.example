# Copy to .env.local and fill in.
#
# The enquiry form's delivery key. Get one at https://web3forms.com — enter
# hello@pulitodigital.com.au and the key arrives by email. Public by design
# (it identifies the destination inbox, not a secret), which is why it is a
# NEXT_PUBLIC_ variable. Without it the form validates and acknowledges
# locally and sends nothing.
NEXT_PUBLIC_WEB3FORMS_KEY=
